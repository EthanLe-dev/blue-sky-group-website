# TEMPLATE ONLY: local values are deliberately non-production.
# Copy to .env without overwriting an existing file. Never commit .env.
# Compose consumes POSTGRES_* and REDIS_PORT only today.
# Application variables below are the M1 configuration contract, not implemented code.

# Go API: bind 0.0.0.0 and honor the PORT injected by Render.
APP_ENV=local
APP_NAME=blue-sky-group
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh
PUBLIC_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8088
# Only trust known proxy addresses after deployment; empty means trust none.
TRUSTED_PROXIES=

# PostgreSQL local. Changing credentials does not reinitialize an existing volume.
POSTGRES_DB=blue_sky_group
POSTGRES_USER=blue_sky
POSTGRES_PASSWORD=local-demo-only-change-me
POSTGRES_PORT=5432
# Keep credentials and port synchronized with POSTGRES_* above; URL-encode special characters.
# For an API container, replace 127.0.0.1 with postgres (internal port 5432).
# Demo Neon: use provider connection strings with TLS, never sslmode=disable remotely.
DATABASE_URL=postgresql://blue_sky:local-demo-only-change-me@127.0.0.1:5432/blue_sky_group?sslmode=disable
# Neon pooled URL for application; direct URL for migrations, separate migration identity in production.
DATABASE_MIGRATION_URL=postgresql://blue_sky:local-demo-only-change-me@127.0.0.1:5432/blue_sky_group?sslmode=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=2
DB_CONN_MAX_LIFETIME_SECONDS=300

# Auth: fill with independent cryptographically random secrets before running the API.
# Loader must reject empty/placeholder secrets. Do not expose them via NEXT_PUBLIC_/VITE_.
JWT_SIGNING_SECRET=
CSRF_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
GUEST_SESSION_TTL_SECONDS=86400
LOOKUP_TOKEN_TTL_SECONDS=900
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# One-time admin bootstrap only; clear after creation. No default password.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Pricing defaults proposed in PLAN; snapshot overrides per departure.
CURRENCY=VND
BOOKING_HOLD_TTL_SECONDS=1200
BOOKING_QUOTE_TTL_SECONDS=300
BOOKING_MAX_TRAVELLERS=20
DEFAULT_DEPOSIT_BPS=3000
DEFAULT_BALANCE_DUE_DAYS_BEFORE_DEPARTURE=7
EXPIRY_SWEEP_INTERVAL_SECONDS=60
OUTBOX_POLL_INTERVAL_SECONDS=5
OUTBOX_MAX_ATTEMPTS=5

# MVP only. Public demo must display mock labels. Production must reject mock providers.
PAYMENT_PROVIDER=mock
EMAIL_PROVIDER=mock
SMS_PROVIDER=mock
# Turnstile mock is LOCAL ONLY; public demo uses real Turnstile siteverify.
TURNSTILE_MODE=mock
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1

# Local disk adapter for development only; use r2 on ephemeral demo hosts.
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BASE_URL=
PRIVATE_DOWNLOAD_TTL_SECONDS=300
EXPORT_MAX_ROWS=10000

# Optional local Redis profile; MVP code must work with CACHE_PROVIDER=none.
CACHE_PROVIDER=none
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# Next.js server-only upstream for same-origin /api/v1 proxy (never NEXT_PUBLIC_).
# Root .env is not automatically read by Next.js/Vite; copy the relevant variables
# into frontend/.env.local and admin/.env.local or inject them in the host dashboard.
API_UPSTREAM_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_DEMO_MODE=true
# Suggested Leaflet/OpenStreetMap integration; show required attribution.
# Reassess tile provider usage policy/limits before public deployment.
NEXT_PUBLIC_MAP_PROVIDER=leaflet

# React/Vite: only public values may use VITE_ prefix.
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:8080
VITE_TURNSTILE_SITE_KEY=
VITE_DEMO_MODE=true

# Local Admin builds only; public host uses real Turnstile with site key.
VITE_TURNSTILE_MODE=mock
